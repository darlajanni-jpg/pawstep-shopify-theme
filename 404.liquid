<style>
  :root {
    --cream: #FAF6F0;
    --warm: #F5EDE0;
    --sand: #E8D5B7;
    --brown: #8B5E3C;
    --dark: #2C1A0E;
    --paw: #C4855A;
    --accent: #E8734A;
    --soft: #D4A574;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }

  body {
    background: var(--cream);
    color: var(--dark);
    font-family: 'DM Sans', sans-serif;
    overflow-x: hidden;
    cursor: none;
  }

  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=DM+Sans:wght@300;400;500&display=swap');

  /* CURSOR */
  .cursor {
    position: fixed;
    width: 36px; height: 36px;
    pointer-events: none;
    z-index: 9999;
    transform: translate(-50%, -50%);
    transition: transform 0.1s ease;
  }
  .cursor svg { width: 100%; height: 100%; }

  /* PAW TRAIL */
  .paw-trail {
    position: fixed;
    pointer-events: none;
    z-index: 9998;
    width: 28px; height: 28px;
    transform: translate(-50%, -50%);
    opacity: 0;
    animation: pawFade 1.2s ease forwards;
  }
  @keyframes pawFade {
    0%   { opacity: 0.7; transform: translate(-50%,-50%) scale(0.6) rotate(var(--rot)); }
    30%  { opacity: 0.5; transform: translate(-50%,-50%) scale(1)   rotate(var(--rot)); }
    100% { opacity: 0;   transform: translate(-50%,-50%) scale(0.9) rotate(var(--rot)); }
  }

  /* NAV */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    display: flex; justify-content: space-between; align-items: center;
    padding: 20px 60px;
    background: rgba(250,246,240,0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(139,94,60,0.12);
  }
  .logo {
    font-family: 'Playfair Display', serif;
    font-size: 1.6rem; font-weight: 900;
    color: var(--brown);
    display: flex; align-items: center; gap: 8px;
  }
  .logo span { color: var(--accent); }
  nav ul { list-style: none; display: flex; gap: 40px; }
  nav ul a {
    text-decoration: none; color: var(--dark);
    font-size: 0.85rem; font-weight: 500;
    letter-spacing: 0.08em; text-transform: uppercase;
    position: relative;
  }
  nav ul a::after {
    content: ''; position: absolute; bottom: -3px; left: 0; right: 100%;
    height: 1px; background: var(--accent); transition: right 0.3s ease;
  }
  nav ul a:hover::after { right: 0; }
  .nav-cta {
    background: var(--dark); color: var(--cream) !important;
    padding: 10px 24px; border-radius: 40px;
    font-size: 0.8rem !important; letter-spacing: 0.1em;
    transition: background 0.3s, transform 0.2s;
  }
  .nav-cta:hover { background: var(--accent) !important; transform: scale(1.04); }
  .nav-cta::after { display: none !important; }

  /* HERO */
  .hero {
    min-height: 100vh;
    display: grid; grid-template-columns: 1fr 1fr;
    align-items: center; padding: 120px 60px 60px;
    position: relative; overflow: hidden;
  }
  .hero-bg-paws { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .bg-paw {
    position: absolute; opacity: 0.045;
    animation: drift linear infinite;
  }
  @keyframes drift {
    0%   { transform: translateY(110vh) rotate(0deg); }
    100% { transform: translateY(-20vh) rotate(360deg); }
  }
  .hero-text { position: relative; z-index: 2; }
  .hero-badge {
    display: inline-block; background: var(--sand); color: var(--brown);
    font-size: 0.72rem; font-weight: 500; letter-spacing: 0.15em;
    text-transform: uppercase; padding: 7px 18px; border-radius: 40px;
    margin-bottom: 28px; border: 1px solid rgba(139,94,60,0.2);
  }
  .hero h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(3rem, 5vw, 5.5rem);
    font-weight: 900; line-height: 1.05;
    color: var(--dark); margin-bottom: 24px;
  }
  .hero h1 em { font-style: italic; color: var(--accent); }
  .hero p {
    font-size: 1.05rem; line-height: 1.75;
    color: rgba(44,26,14,0.65); max-width: 440px; margin-bottom: 44px;
  }
  .hero-btns { display: flex; gap: 16px; align-items: center; }
  .btn-primary {
    display: inline-flex; align-items: center; gap: 10px;
    background: var(--dark); color: var(--cream);
    padding: 16px 36px; border-radius: 50px;
    text-decoration: none; font-size: 0.9rem; font-weight: 500;
    letter-spacing: 0.05em;
    transition: background 0.3s, transform 0.2s, box-shadow 0.3s;
    box-shadow: 0 8px 30px rgba(44,26,14,0.2);
  }
  .btn-primary:hover {
    background: var(--accent); transform: translateY(-2px);
    box-shadow: 0 12px 40px rgba(232,115,74,0.35);
  }
  .btn-secondary {
    color: var(--brown); font-size: 0.88rem; font-weight: 500;
    text-decoration: none; display: flex; align-items: center; gap: 6px;
    transition: gap 0.2s;
  }
  .btn-secondary:hover { gap: 12px; }

  /* PRODUCT VISUAL */
  .hero-visual {
    position: relative; display: flex;
    justify-content: center; align-items: center; z-index: 2;
  }
  .product-ring {
    width: 480px; height: 480px; border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, var(--sand), var(--warm) 70%);
    display: flex; align-items: center; justify-content: center;
    position: relative;
    box-shadow: 0 30px 80px rgba(139,94,60,0.18), inset 0 -10px 40px rgba(0,0,0,0.05);
    animation: float 6s ease-in-out infinite;
  }
  @keyframes float {
    0%, 100% { transform: translateY(0px) rotate(-1deg); }
    50%       { transform: translateY(-18px) rotate(1deg); }
  }
  .slipper-svg { width: 280px; height: 280px; }
  .orbit-paw { position: absolute; animation: orbit linear infinite; }
  @keyframes orbit {
    from { transform: rotate(var(--start)) translateX(200px) rotate(calc(-1 * var(--start))); }
    to   { transform: rotate(calc(var(--start) + 360deg)) translateX(200px) rotate(calc(-1 * (var(--start) + 360deg))); }
  }
  .price-tag {
    position: absolute; bottom: 40px; right: -20px;
    background: var(--dark); color: var(--cream);
    border-radius: 20px; padding: 16px 24px;
    box-shadow: 0 12px 40px rgba(44,26,14,0.25);
    animation: float 6s ease-in-out infinite 1.5s;
  }
  .price-tag .price { font-family: 'Playfair Display', serif; font-size: 1.8rem; font-weight: 900; }
  .price-tag .label { font-size: 0.7rem; letter-spacing: 0.1em; opacity: 0.6; text-transform: uppercase; }

  /* TRAIL SECTION */
  .trail-section {
    padding: 100px 60px; background: var(--warm);
    position: relative; overflow: hidden; text-align: center;
  }
  .trail-section h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 3.5vw, 3.5rem); font-weight: 900; margin-bottom: 16px;
  }
  .trail-section p {
    color: rgba(44,26,14,0.6); font-size: 1rem;
    max-width: 480px; margin: 0 auto 60px; line-height: 1.7;
  }
  .trail-canvas {
    width: 100%; max-width: 700px; height: 220px;
    margin: 0 auto; position: relative; background: var(--cream);
    border-radius: 24px; border: 1px solid var(--sand); overflow: hidden;
    box-shadow: inset 0 4px 20px rgba(139,94,60,0.06);
  }
  .trail-paw {
    position: absolute;
    animation: trailWalk 6s ease-in-out infinite;
    opacity: 0;
  }
  @keyframes trailWalk {
    0%   { opacity: 0;   transform: translate(-50%,-50%) scale(0.5) rotate(var(--tr)); }
    10%  { opacity: 0.8; transform: translate(-50%,-50%) scale(1)   rotate(var(--tr)); }
    90%  { opacity: 0.8; transform: translate(-50%,-50%) scale(1)   rotate(var(--tr)); }
    100% { opacity: 0;   transform: translate(-50%,-50%) scale(0.5) rotate(var(--tr)); }
  }

  /* FEATURES */
  .features-wrap { padding: 80px 0 0; }
  .features-title {
    text-align: center; padding: 0 60px; margin-bottom: 60px;
  }
  .features-title h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem,3vw,3rem); font-weight: 900;
  }
  .features-title h2 em { font-style: italic; color: var(--accent); }
  .features {
    padding: 0 60px 100px; display: grid;
    grid-template-columns: repeat(3, 1fr); gap: 32px;
    max-width: 1200px; margin: 0 auto;
  }
  .feature-card {
    background: var(--warm); border-radius: 24px; padding: 44px 36px;
    border: 1px solid rgba(139,94,60,0.1);
    transition: transform 0.3s, box-shadow 0.3s; position: relative; overflow: hidden;
  }
  .feature-card::before {
    content: ''; position: absolute; top: -40px; right: -40px;
    width: 120px; height: 120px; border-radius: 50%;
    background: var(--sand); opacity: 0.5; transition: transform 0.4s;
  }
  .feature-card:hover { transform: translateY(-6px); box-shadow: 0 24px 60px rgba(139,94,60,0.12); }
  .feature-card:hover::before { transform: scale(1.5); }
  .feat-icon {
    width: 52px; height: 52px; background: var(--brown); border-radius: 16px;
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 24px; position: relative; z-index: 1;
  }
  .feature-card h3 {
    font-family: 'Playfair Display', serif; font-size: 1.35rem;
    font-weight: 700; margin-bottom: 12px; position: relative; z-index: 1;
  }
  .feature-card p {
    color: rgba(44,26,14,0.6); font-size: 0.9rem;
    line-height: 1.7; position: relative; z-index: 1;
  }

  /* COLORS */
  .variants-section {
    padding: 100px 60px; background: var(--dark);
    color: var(--cream); text-align: center;
  }
  .variants-section h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem,3vw,3rem); margin-bottom: 12px;
  }
  .variants-section > p { color: rgba(250,246,240,0.5); margin-bottom: 60px; font-size: 0.95rem; }
  .color-grid { display: flex; gap: 24px; justify-content: center; flex-wrap: wrap; }
  .color-card {
    background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.08);
    border-radius: 20px; padding: 32px 28px; width: 180px; text-align: center;
    cursor: pointer; transition: transform 0.3s, border-color 0.3s, background 0.3s;
  }
  .color-card:hover, .color-card.active {
    transform: translateY(-8px); border-color: var(--accent);
    background: rgba(232,115,74,0.08);
  }
  .color-swatch {
    width: 60px; height: 60px; border-radius: 50%;
    margin: 0 auto 16px; display: flex; align-items: center; justify-content: center;
    font-size: 1.4rem; box-shadow: 0 8px 20px rgba(0,0,0,0.3);
  }
  .color-card h4 { font-size: 0.85rem; font-weight: 500; letter-spacing: 0.05em; }
  .color-card p { font-size: 0.75rem; color: rgba(250,246,240,0.4); margin-top: 4px; }

  /* HOW IT WORKS */
  .how-section { padding: 100px 60px; max-width: 1200px; margin: 0 auto; }
  .how-section h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem,3vw,3rem); text-align: center; margin-bottom: 70px;
  }
  .steps {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 0; position: relative;
  }
  .steps::before {
    content: ''; position: absolute; top: 32px; left: 12%; right: 12%;
    height: 1px; background: linear-gradient(to right, transparent, var(--sand), var(--sand), transparent);
  }
  .step { text-align: center; padding: 0 20px; position: relative; }
  .step-num {
    width: 64px; height: 64px; border-radius: 50%;
    background: var(--warm); border: 2px solid var(--sand);
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 28px; font-family: 'Playfair Display', serif;
    font-size: 1.2rem; font-weight: 900; color: var(--brown);
    position: relative; z-index: 1;
    transition: background 0.3s, border-color 0.3s, transform 0.3s;
  }
  .step:hover .step-num {
    background: var(--accent); border-color: var(--accent);
    color: white; transform: scale(1.1);
  }
  .step h3 { font-size: 1rem; font-weight: 600; margin-bottom: 10px; }
  .step p { font-size: 0.85rem; color: rgba(44,26,14,0.6); line-height: 1.6; }

  /* TESTIMONIALS */
  .testimonials { padding: 100px 60px; background: var(--warm); }
  .testimonials h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem,3vw,3rem); text-align: center; margin-bottom: 60px;
  }
  .testi-grid {
    display: grid; grid-template-columns: repeat(3,1fr);
    gap: 28px; max-width: 1100px; margin: 0 auto;
  }
  .testi-card {
    background: var(--cream); border-radius: 20px; padding: 36px;
    border: 1px solid rgba(139,94,60,0.08); position: relative;
  }
  .testi-card::before {
    content: '"'; font-family: 'Playfair Display', serif; font-size: 6rem;
    color: var(--sand); position: absolute; top: -10px; left: 24px; line-height: 1;
  }
  .stars { color: var(--accent); font-size: 0.85rem; margin-bottom: 16px; }
  .testi-card p {
    font-size: 0.9rem; line-height: 1.7; color: rgba(44,26,14,0.7);
    margin-bottom: 24px; position: relative; z-index: 1;
  }
  .testi-author { display: flex; align-items: center; gap: 12px; }
  .testi-avatar {
    width: 40px; height: 40px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.2rem; background: var(--sand);
  }
  .testi-name { font-weight: 600; font-size: 0.85rem; }
  .testi-sub { font-size: 0.75rem; color: rgba(44,26,14,0.45); }

  /* CTA */
  .cta-section {
    padding: 120px 60px;
    background: linear-gradient(135deg, var(--brown) 0%, var(--dark) 100%);
    color: var(--cream); text-align: center; position: relative; overflow: hidden;
  }
  .cta-section h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.2rem,4vw,4.5rem); margin-bottom: 16px; position: relative;
  }
  .cta-section > p {
    color: rgba(250,246,240,0.6); margin-bottom: 48px;
    font-size: 1rem; position: relative;
  }
  .cta-btns { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; position: relative; }
  .btn-cta {
    display: inline-flex; align-items: center; gap: 10px;
    background: var(--cream); color: var(--dark); padding: 18px 44px;
    border-radius: 50px; text-decoration: none; font-size: 0.95rem;
    font-weight: 600; letter-spacing: 0.04em;
    transition: background 0.3s, transform 0.2s, box-shadow 0.3s;
    box-shadow: 0 10px 40px rgba(0,0,0,0.3);
  }
  .btn-cta:hover {
    background: var(--accent); color: white; transform: translateY(-3px);
    box-shadow: 0 16px 50px rgba(232,115,74,0.4);
  }
  .btn-ghost {
    display: inline-flex; align-items: center; gap: 10px;
    border: 1px solid rgba(250,246,240,0.3); color: var(--cream);
    padding: 18px 44px; border-radius: 50px; text-decoration: none;
    font-size: 0.95rem; font-weight: 500;
    transition: border-color 0.3s, background 0.3s;
  }
  .btn-ghost:hover { border-color: var(--cream); background: rgba(250,246,240,0.07); }

  /* FOOTER */
  footer {
    background: var(--dark); color: rgba(250,246,240,0.5);
    padding: 60px; display: flex;
    justify-content: space-between; align-items: center; font-size: 0.82rem;
  }
  footer .logo { color: var(--cream); font-size: 1.2rem; }
  footer p { margin-top: 6px; }

  /* SCROLL REVEAL */
  .reveal { opacity: 0; transform: translateY(30px); transition: opacity 0.7s ease, transform 0.7s ease; }
  .reveal.visible { opacity: 1; transform: translateY(0); }
  .reveal-delay-1 { transition-delay: 0.1s; }
  .reveal-delay-2 { transition-delay: 0.2s; }
  .reveal-delay-3 { transition-delay: 0.3s; }
  .reveal-delay-4 { transition-delay: 0.4s; }

  /* RESPONSIVE */
  @media (max-width: 900px) {
    nav { padding: 16px 24px; }
    nav ul { display: none; }
    .hero { grid-template-columns: 1fr; padding: 100px 24px 60px; text-align: center; }
    .hero p { margin: 0 auto 40px; }
    .hero-btns { justify-content: center; }
    .hero-visual { margin-top: 40px; }
    .product-ring { width: 320px; height: 320px; }
    .features { grid-template-columns: 1fr; padding: 60px 24px; }
    .variants-section { padding: 60px 24px; }
    .how-section { padding: 60px 24px; }
    .steps { grid-template-columns: 1fr 1fr; gap: 40px; }
    .steps::before { display: none; }
    .testimonials { padding: 60px 24px; }
    .testi-grid { grid-template-columns: 1fr; }
    .cta-section { padding: 80px 24px; }
    footer { flex-direction: column; gap: 16px; text-align: center; padding: 40px 24px; }
  }
</style>

