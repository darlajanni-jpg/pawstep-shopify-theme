<script>
  // CURSOR
  const cursor = document.getElementById('cursor');
  let pawCount = 0;
  const rots = [-20, 15, -10, 25, -5, 20];

  document.addEventListener('mousemove', e => {
    cursor.style.left = e.clientX + 'px';
    cursor.style.top  = e.clientY + 'px';
  });

  document.addEventListener('click', e => { spawnPawTrail(e.clientX, e.clientY); });

  let lastPawX = 0, lastPawY = 0;
  document.addEventListener('mousemove', e => {
    const dist = Math.hypot(e.clientX - lastPawX, e.clientY - lastPawY);
    if (dist > 80) {
      lastPawX = e.clientX; lastPawY = e.clientY;
      spawnPawTrail(e.clientX, e.clientY, true);
    }
  });

  function spawnPawTrail(x, y, small = false) {
    const paw = document.createElement('div');
    paw.className = 'paw-trail';
    const rot = rots[pawCount % rots.length];
    paw.style.setProperty('--rot', rot + 'deg');
    paw.style.left = x + 'px';
    paw.style.top  = y + 'px';
    if (small) { paw.style.width = '18px'; paw.style.height = '18px'; }
    paw.innerHTML = `<svg viewBox="0 0 100 100" fill="none">
      <ellipse cx="50" cy="68" rx="22" ry="18" fill="#C4855A"/>
      <ellipse cx="30" cy="45" rx="11" ry="9" fill="#C4855A"/>
      <ellipse cx="50" cy="38" rx="11" ry="9" fill="#C4855A"/>
      <ellipse cx="70" cy="45" rx="11" ry="9" fill="#C4855A"/>
      <ellipse cx="18" cy="62" rx="8" ry="10" fill="#C4855A"/>
      <ellipse cx="82" cy="62" rx="8" ry="10" fill="#C4855A"/>
    </svg>`;
    document.body.appendChild(paw);
    paw.addEventListener('animationend', () => paw.remove());
    pawCount++;
  }

  // BACKGROUND PAWS
  const bgPaws = document.getElementById('bgPaws');
  for (let i = 0; i < 12; i++) {
    const p = document.createElement('div');
    p.className = 'bg-paw';
    const size = 30 + Math.random() * 60;
    p.style.cssText = `left:${Math.random()*100}%;width:${size}px;height:${size}px;animation-duration:${10+Math.random()*20}s;animation-delay:${-Math.random()*20}s;`;
    p.innerHTML = `<svg viewBox="0 0 100 100" fill="none"><ellipse cx="50" cy="68" rx="22" ry="18" fill="#8B5E3C"/><ellipse cx="30" cy="45" rx="11" ry="9" fill="#8B5E3C"/><ellipse cx="50" cy="38" rx="11" ry="9" fill="#8B5E3C"/><ellipse cx="70" cy="45" rx="11" ry="9" fill="#8B5E3C"/><ellipse cx="18" cy="62" rx="8" ry="10" fill="#8B5E3C"/><ellipse cx="82" cy="62" rx="8" ry="10" fill="#8B5E3C"/></svg>`;
    bgPaws.appendChild(p);
  }

  // TRAIL CANVAS
  const canvas = document.getElementById('trailCanvas');
  const trailData = [
    {x:'8%', y:'55%', rot:-15, delay:0},   {x:'18%',y:'35%',rot:10, delay:0.4},
    {x:'29%',y:'60%',rot:-12,delay:0.8},   {x:'40%',y:'38%',rot:8,  delay:1.2},
    {x:'51%',y:'62%',rot:-18,delay:1.6},   {x:'62%',y:'36%',rot:12, delay:2.0},
    {x:'73%',y:'58%',rot:-10,delay:2.4},   {x:'84%',y:'34%',rot:15, delay:2.8},
    {x:'92%',y:'56%',rot:-8, delay:3.2},
  ];
  trailData.forEach(t => {
    const p = document.createElement('div');
    p.className = 'trail-paw';
    p.style.cssText = `left:${t.x};top:${t.y};width:36px;height:36px;--tr:${t.rot}deg;animation-delay:${t.delay}s;`;
    p.innerHTML = `<svg viewBox="0 0 100 100" fill="none"><ellipse cx="50" cy="68" rx="22" ry="18" fill="#8B5E3C"/><ellipse cx="30" cy="45" rx="11" ry="9" fill="#8B5E3C"/><ellipse cx="50" cy="38" rx="11" ry="9" fill="#8B5E3C"/><ellipse cx="70" cy="45" rx="11" ry="9" fill="#8B5E3C"/><ellipse cx="18" cy="62" rx="8" ry="10" fill="#8B5E3C"/><ellipse cx="82" cy="62" rx="8" ry="10" fill="#8B5E3C"/></svg>`;
    canvas.appendChild(p);
  });

  // SCROLL REVEAL
  const reveals = document.querySelectorAll('.reveal');
  const observer = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.15 });
  reveals.forEach(el => observer.observe(el));
  document.querySelectorAll('.hero .reveal').forEach((el, i) => {
    setTimeout(() => el.classList.add('visible'), i * 150);
  });

  // COLOR SELECTION
  function selectColor(el) {
    document.querySelectorAll('.color-card').forEach(c => c.classList.remove('active'));
    el.classList.add('active');
  }
</script>

